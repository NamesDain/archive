{
    "compilerOptions": {
        "outDir": "dist",
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "jsx": "react",
        "jsxFactory": "React.createElement",
        "jsxFragmentFactory": "React.Fragment",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowJs": true
    },
    "include": ["plugins", "node_modules/vendetta-types"]
}
